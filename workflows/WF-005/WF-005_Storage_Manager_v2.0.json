    {
      "parameters": {
        "jsCode": "const canonicalFolders = ['01_Source','02_Chapters','03_Canon','04_Characters','05_World','06_Outline','07_Assets','08_Publish','09_Backup'];\nconst state = $('Capture v001 Folder').first().json;\nconst existing = new Map();\nfor (const item of $input.all()) {\n  const folder = item.json;\n  if (folder?.__canonical_folder_search_seed) continue;\n  if (folder && typeof folder.name === 'string' && folder.id && canonicalFolders.includes(folder.name) && !existing.has(folder.name)) {\n    existing.set(folder.name, folder.id);\n  }\n}\nconst missing_folders = canonicalFolders.filter(name => !existing.has(name));\nreturn [{ json: { ...state, canonical_folders: canonicalFolders, existing_canonical_folder_ids: Object.fromEntries(existing), missing_folders, canonical_folders_missing: missing_folders.length > 0 } }];"
      },
