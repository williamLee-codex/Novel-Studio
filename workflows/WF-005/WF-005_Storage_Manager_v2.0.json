    {
      "parameters": {
        "jsCode": "const expectedFiles = ['README.md', 'workspace.json'];\nconst inputItems = $input.all();\nconst seedItem = inputItems.find(item => item.json?.__workspace_file_search_seed);\nconst state = seedItem?.json || inputItems[0]?.json;\nconst existing = new Map();\nfor (const item of inputItems) {\n  const file = item.json;\n  if (file?.__workspace_file_search_seed) continue;\n  if (file && typeof file.name === 'string' && file.id && expectedFiles.includes(file.name) && !existing.has(file.name)) {\n    existing.set(file.name, file.id);\n  }\n}\nconst now = new Date().toISOString();\nconst readme = `# ${state.project_name}\n\nWorkspace Version\n\nv001\n\nGenerated by\n\nNovel Studio\n\nStorage Engine\n\nVersion 2.1\n`;\nconst workspace = JSON.stringify({\n  storage_engine_version: '2.1',\n  workspace_version: 'v001',\n  project_name: state.project_name,\n  project_key: state.project_key,\n  project_folder_id: state.project_folder_id,\n  workspace_folder_id: state.workspace_folder_id,\n  created_at: now,\n  last_updated: now,\n}, null, 2);\nconst fileDefinitions = {\n  'README.md': { mimeType: 'text/markdown', content: readme },\n  'workspace.json': { mimeType: 'application/json', content: workspace },\n};\nconst missing_files = expectedFiles.filter(name => !existing.has(name));\nreturn [{ json: { ...state, workspace_files: expectedFiles, existing_workspace_file_ids: Object.fromEntries(existing), missing_files, workspace_files_missing: missing_files.length > 0, file_definitions: fileDefinitions } }];"
      },
      "id": "86092465-d7e7-4a78-9ea5-3ba7020a5a65",
      "name": "Plan Workspace Files",
