      "name": "Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const input = $json && typeof $json === 'object' && !Array.isArray($json) ? $json : {};\nconst request = input.storage_request;\nif (!request || typeof request !== 'object' || Array.isArray(request)) {\n  throw new Error('storage_request is required');\n}\nif (request.operation !== 'initialize_workspace') {\n  throw new Error('storage_request.operation must be initialize_workspace');\n}\nif (typeof request.project_key !== 'string' || !request.project_key.trim()) {\n  throw new Error('storage_request.project_key is required');\n}\nif (typeof request.project_name !== 'string' || !request.project_name.trim()) {\n  throw new Error('storage_request.project_name is required');\n}\nreturn [{ json: { storage_request: { operation: request.operation, project_key: request.project_key.trim(), project_name: request.project_name.trim() } } }];"
      },
      "id": "439ddfb1-719c-4cd4-bc67-9f99394b0c10",
      "name": "Validate Storage Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "searchMethod": "query",
        "queryString": "name = '小說' and 'root' in parents and mimeType = 'application/vnd.google-apps.folder' and trashed = false",
        "returnAll": true,
        "filter": {},
        "options": {}
      },
      "id": "ce748c2c-bb06-473e-ad29-38c63e4885cf",
      "name": "Find folder 小說",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [480, 0],
      "alwaysOutputData": true,
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "google-drive-oauth2",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const folders = $input.all().map(item => item.json).filter(item => item && item.id);\nconst request = $('Validate Storage Request').first().json.storage_request;\nreturn [{ json: { storage_request: request, storage_root_id: folders[0]?.id || '', root_missing: folders.length === 0 } }];"
      },
      "id": "4e6edfc4-e79c-48fa-9b57-d8ea95619777",
