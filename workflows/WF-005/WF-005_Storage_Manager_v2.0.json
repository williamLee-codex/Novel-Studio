      "parameters": {
        "jsCode": "const prepared=$('Prepare Nine Folders').all();const made=$input.all();const base=prepared[0].json;const folder_map={};prepared.forEach((p,i)=>folder_map[p.json.folder_name]=made[i]?.json?.id??'');const storage={storage_version:'2.0',project_folder_id:base.project_folder_id,workspace_folder_id:base.workspace_folder_id,workspace_version:base.workspace_version,folder_map};const workspace={storage_version:'2.0',novel_uuid:base.novel.novel_uuid,novel_title:base.novel.novel_title,workspace_version:base.workspace_version,created_at:new Date().toISOString()};const readme=`# ${base.novel.novel_title}\\n\\nWorkspace ${base.workspace_version} managed by Novel Studio Storage Engine V2.\\n`;return ['README.md','workspace.json'].map(file_name=>({json:{...base,storage,file_name,parent_folder_id:base.workspace_folder_id,content:file_name==='README.md'?readme:JSON.stringify(workspace,null,2)}}));"
