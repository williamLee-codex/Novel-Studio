      "parameters": {
        "jsCode": "const b=$('Build Folder Map and Files').first().json;const hit=$input.all().map(i=>i.json).find(x=>x?.id);let index={storage_version:'2.0',novels:[]};if(hit?.content){try{index=JSON.parse(hit.content)}catch{}}if(!Array.isArray(index.novels))index.novels=[];const entry={novel_uuid:b.novel.novel_uuid,title:b.novel.novel_title,project_folder_id:b.storage.project_folder_id,workspace_folder_id:b.storage.workspace_folder_id,latest_workspace:b.storage.workspace_version,updated_at:new Date().toISOString()};const i=index.novels.findIndex(x=>x.novel_uuid===entry.novel_uuid||x.title===entry.title);if(i<0)index.novels.push(entry);else index.novels[i]={...index.novels[i],...entry};return[{json:{...b,file_name:'_index.json',parent_folder_id:b.storage_root_id,content:JSON.stringify(index,null,2)}}];"
