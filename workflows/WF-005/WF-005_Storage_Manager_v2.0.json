        "jsCode": "const novel=$json.novel??{};const isChapter=$json.route==='chapter.persistence.created';const errors=[];if(!isChapter){for(const k of ['novel_uuid','novel_title'])if(typeof novel[k]!=='string'||!novel[k].trim())errors.push(`novel.${k} is required`);}else if(!$json.storage?.workspace_folder_id&&!$json.workspace_folder_id)errors.push('storage.workspace_folder_id is required for chapter storage');return[{json:{...$json,storage_mode:isChapter?'chapter':'workspace',novel,validation_errors:errors,is_valid:errors.length===0}}];"
