{
  "name": "WF-005B - Storage File Writer v1.1",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "6486931a-6012-440a-bf9d-ba799453b62c",
      "name": "Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const errors=[];if($json.route!=='storage.files.write.requested')errors.push('route must target WF-005B');const map=$json.folder_id_map??{};if(!map.workspace)errors.push('folder_id_map.workspace is required');if(!Array.isArray($json.file_operations))errors.push('file_operations must be an array');for(const f of $json.file_operations??[])if(!map[f.folder_key])errors.push(`folder_id_map.${f.folder_key} is required for ${f.file_name}`);return[{json:{...$json,is_valid:errors.length===0,validation_errors:errors}}];"
      },
      "id": "10c9a148-48ac-4d7b-aff5-76b6c2997d3e",
      "name": "Validate folder_id_map",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "if(!$json.is_valid)return[{json:{...$json,operation:null}}];return $json.file_operations.map(operation=>({json:{...$json,operation,file_name:operation.file_name,content:operation.initial_content,parent_folder_id:$json.folder_id_map[operation.folder_key]}}));"
      },
      "id": "7e663f39-3a11-4d20-bcef-1ac8faead04a",
      "name": "Prepare Workspace Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "operation": "toText",
        "sourceProperty": "content",
        "options": {
