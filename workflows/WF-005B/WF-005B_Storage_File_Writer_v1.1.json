          "encoding": "utf8"
        }
      },
      "id": "17fa3068-c945-40cd-a933-ebdfd0f8ed44",
      "name": "Convert Workspace Content",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "inputDataFieldName": "data",
        "name": "={{ $json.file_name }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.parent_folder_id }}"
        },
        "options": {}
      },
      "id": "6108358e-c8c9-4bf7-88db-b8bd8ffc403a",
      "name": "Write Workspace Markdown and JSON",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const s=$('Validate folder_id_map').first().json;const now=new Date().toISOString();return[{json:{...s,index_entry:{title:s.workspace.novel_title,novel_uuid:s.workspace.novel_uuid,project_folder_id:s.project_folder_id,latest_workspace:s.workspace_version,workspace_count:s.workspace_count,created_at:s.workspace.created_at,updated_at:now}}}];"
      },
      "id": "41f18d25-89bb-4384-9cd2-25bb0baac2f9",
      "name": "Prepare Novel Index Entry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "queryString": "={{ \"name = '_index.json' and '\" + $json.storage_root_id + \"' in parents and trashed = false\" }}",
        "returnAll": true,
        "filter": {},
        "options": {}
      },
      "id": "6642d791-fc7a-4385-8868-361c59515e9c",
      "name": "Find _index.json",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1320,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const s=$('Prepare Novel Index Entry').first().json;const hit=$input.all().map(i=>i.json).find(x=>x&&x.id);let index={novels:[]};if(hit?.content){try{index=JSON.parse(hit.content)}catch{index={novels:[]}}}if(!Array.isArray(index.novels))index.novels=[];const i=index.novels.findIndex(n=>n.novel_uuid===s.index_entry.novel_uuid||n.title===s.index_entry.title);if(i>=0){s.index_entry.created_at=index.novels[i].created_at||s.index_entry.created_at;index.novels.splice(i,1,s.index_entry);}else index.novels.push(s.index_entry);return[{json:{...s,index_file_id:hit?.id??'',file_name:'_index.json',parent_folder_id:s.storage_root_id,content:JSON.stringify(index,null,2)}}];"
      },
      "id": "e0e67490-fdf5-47a4-9c9b-cb5242f82c91",
      "name": "Build Updated _index.json",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
