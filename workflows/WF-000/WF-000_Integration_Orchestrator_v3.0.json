        "jsCode": "const input = ($json && typeof $json === 'object' && !Array.isArray($json)) ? $json : {};\nconst rawCommand = typeof input.command === 'string' ? input.command : (typeof input.route === 'string' ? input.route : '');\nconst command = rawCommand.trim().replace(/^\\//, '').toLowerCase();\nconst telegram_chat_id = Number(input.telegram_chat_id ?? input.telegram?.chat_id);\n\nif (command !== 'new') {\n  throw new Error('Wave 2 supports only the new command.');\n}\nif (!Number.isFinite(telegram_chat_id)) {\n  throw new Error('telegram_chat_id must be a finite number.');\n}\n\nreturn [{ json: { ...input, command: 'new', telegram_chat_id } }];"
      },
