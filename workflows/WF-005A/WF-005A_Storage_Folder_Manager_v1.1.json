        "jsCode": "const base=$('Prepare Nine Workspace Folders').first().json;const prepared=$('Prepare Nine Workspace Folders').all();const made=$input.all();const folder_id_map={workspace:base.workspace_folder_id};prepared.forEach((p,i)=>{folder_id_map[p.json.folder_name]=made[i]?.json?.id??''});if(Object.values(folder_id_map).some(v=>!v))return[{json:{...base,is_valid:false,validation_errors:[...(base.validation_errors??[]),'one or more workspace folders failed']}}];const created_at=base.workspace.created_at;const workspace={...base.workspace,workspace_version:base.workspace_version};const files=base.persistence_plan.file_operations.map(o=>({...o,initial_content:o.file_name==='workspace.json'?JSON.stringify({workspace_uuid:workspace.workspace_uuid,workspace_version:base.workspace_version,novel_uuid:workspace.novel_uuid,title:workspace.novel_title,created_at},null,2):o.initial_content}));return[{json:{schema_version:'1.1',workflow_version:'1.0',route:'storage.files.write.requested',target:'WF-005B',status:'ready',is_valid:true,storage_root_id:base.storage_root_id,project_folder_id:base.project_folder_id,workspace_folder_id:base.workspace_folder_id,workspace_version:base.workspace_version,workspace_count:base.workspace_count,folder_id_map,file_operations:files,workspace,context:base.context??{}}}];"
