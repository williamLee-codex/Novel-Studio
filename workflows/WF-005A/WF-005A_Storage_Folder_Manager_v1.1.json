        "jsCode": "const errors=[];const w=$json.workspace??{};const p=$json.persistence_plan??{};if($json.route!=='workspace.storage.provision.requested')errors.push('route must target WF-005A');if(w.storage_root_name!=='小說'||p.storage_root_name!=='小說')errors.push('storage root must be 小說');for(const f of ['workspace_uuid','novel_uuid','novel_title'])if(typeof w[f]!=='string'||!w[f].trim())errors.push(`workspace.${f} is required`);return[{json:{...$json,is_valid:errors.length===0,validation_errors:errors}}];"
