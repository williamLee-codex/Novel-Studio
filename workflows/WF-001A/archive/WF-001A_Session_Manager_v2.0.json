    {
      "parameters": {
        "jsCode": "const request = $('Validate and Normalize Input').item.json;\nif (!request.valid) return [{ json: { ok: false, operation: request.operation, session: {}, error: request.error } }];\nconst result = ($json && typeof $json === 'object' && !Array.isArray($json)) ? $json : {};\nconst nodeError = String(result.error?.message ?? result.error ?? '').trim();\nif (nodeError) return [{ json: { ok: false, operation: request.operation, session: {}, error: nodeError } }];\nif (request.operation === 'clear_session') return [{ json: { ok: true, operation: request.operation, session: {}, error: '' } }];\nconst stored = Object.keys(result).length ? result : {};\nconst session = request.operation === 'read_session'\n  ? stored\n  : { ...request.session_data, ...stored, telegram_chat_id: request.telegram_chat_id, telegram_user_id: request.telegram_user_id, novel_uuid: request.novel_uuid, chapter_uuid: request.operation === 'update_chapter' ? request.chapter_uuid : String(request.session_data.chapter_uuid ?? request.chapter_uuid ?? '') };\nreturn [{ json: { ok: true, operation: request.operation, session, error: '' } }];"
      },
