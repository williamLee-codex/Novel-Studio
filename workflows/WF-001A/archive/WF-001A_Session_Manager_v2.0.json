      "parameters": {
        "jsCode": "const input = ($json && typeof $json === 'object' && !Array.isArray($json)) ? $json : {};\nconst allowed = ['read_session', 'upsert_session', 'update_chapter', 'clear_session'];\nconst operation = String(input.operation ?? '').trim();\nconst errors = [];\nconst numberField = (name) => {\n  const value = input[name];\n  if (typeof value !== 'number' || !Number.isFinite(value)) {\n    errors.push(`${name} must be a finite number.`);\n    return null;\n  }\n  return value;\n};\nconst telegram_chat_id = numberField('telegram_chat_id');\nconst telegram_user_id = numberField('telegram_user_id');\nif (!allowed.includes(operation)) errors.push('operation must be read_session, upsert_session, update_chapter, or clear_session.');\nconst novel_uuid = String(input.novel_uuid ?? '').trim();\nconst chapter_uuid = String(input.chapter_uuid ?? '').trim();\nconst session_data = input.session_data && typeof input.session_data === 'object' && !Array.isArray(input.session_data) ? input.session_data : {};\nif (['upsert_session', 'update_chapter'].includes(operation) && !novel_uuid) errors.push('novel_uuid is required for this operation.');\nif (operation === 'update_chapter' && !chapter_uuid) errors.push('chapter_uuid is required for update_chapter.');\nif (operation === 'upsert_session' && (!input.session_data || typeof input.session_data !== 'object' || Array.isArray(input.session_data))) errors.push('session_data must be an object for upsert_session.');\nreturn [{ json: { operation, telegram_chat_id, telegram_user_id, novel_uuid, chapter_uuid, session_data, valid: errors.length === 0, error: errors.join(' ') } }];"
      },
